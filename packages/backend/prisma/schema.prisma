generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["relationJoins"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @db.VarChar(24) // From YouTube
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    displayName     String
    lastRefreshedAt DateTime
    raw             Json

    sessions      Session[]
    subscriptions Subscription[]
    userVideos    UserVideo[]
    Setting       Setting[]

    @@index([createdAt])
    @@index([updatedAt])
}

model Session {
    id        String   @id @db.VarChar(24)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    token               String @unique @db.VarChar(24)
    youtubeAccessToken  String
    youtubeRefreshToken String

    user   User   @relation(fields: [userId], references: [id])
    userId String

    @@index([createdAt])
    @@index([updatedAt])
    @@index([userId])
}

model Subscription {
    id        String   @id @db.VarChar(43)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    channelId       String   @db.VarChar(24)
    lastRefreshedAt DateTime
    raw             Json

    user   User   @relation(fields: [userId], references: [id])
    userId String

    @@index([channelId])
    @@index([createdAt])
    @@index([updatedAt])
    @@index([userId])
}

model Channel {
    id        String   @id @db.VarChar(24)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    handle          String
    name            String
    lastRefreshedAt DateTime
    raw             Json

    videos   Video[]
    Playlist Playlist[]

    @@index([createdAt])
    @@index([updatedAt])
}

enum LiveBroadcastContent {
    LIVE
    NONE
    UPCOMING
}

enum UploadStatus {
    DELETED
    FAILED
    PROCESSED
    REJECTED
    UPLOADED
}

enum PrivacyStatus {
    PRIVATE
    PUBLIC
    UNLISTED
}

model Video {
    id        String   @id @db.VarChar(11)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    duration             String
    isShort              Boolean
    liveBroadcastContent LiveBroadcastContent
    privacyStatus        PrivacyStatus
    publishedAt          DateTime
    // thumbnailAspectRatio String // What data type?
    thumbnailUrl         String
    title                String               @db.VarChar(100)
    uploadStatus         UploadStatus
    lastRefreshedAt      DateTime
    raw                  Json

    channel          Channel        @relation(fields: [channelId], references: [id])
    channelId        String         @db.VarChar(24)
    unusedUserVideos UserVideo[]
    PlaylistItem     PlaylistItem[]

    @@index([channelId])
    @@index([createdAt])
    @@index([duration])
    @@index([liveBroadcastContent])
    @@index([privacyStatus])
    @@index([publishedAt])
    @@index([updatedAt])
    @@index([uploadStatus])
}

model UserVideo {
    userId    String   @db.VarChar(24)
    user      User     @relation(fields: [userId], references: [id])
    videoId   String   @db.VarChar(11)
    video     Video    @relation(fields: [videoId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    saved Boolean

    @@id([userId, videoId], name: "userVideos")
    @@index([saved])
    @@index([createdAt])
    @@index([updatedAt])
}

model Playlist {
    id        String   @id @db.VarChar(34)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    itemCount       Int
    privacyStatus   PrivacyStatus
    publishedAt     DateTime
    thumbnailUrl    String
    title           String        @db.VarChar(100)
    lastRefreshedAt DateTime
    raw             Json

    channel       Channel        @relation(fields: [channelId], references: [id])
    channelId     String         @db.VarChar(24)
    playlistItems PlaylistItem[]

    @@index([channelId])
    @@index([createdAt])
    @@index([privacyStatus])
    @@index([publishedAt])
    @@index([updatedAt])
}

model PlaylistItem {
    id        String   @id @db.VarChar(68) // TODO: What size?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    publishedAt     DateTime
    playlist        Playlist @relation(fields: [playlistId], references: [id])
    playlistId      String   @db.VarChar(34)
    position        Int
    lastRefreshedAt DateTime
    raw             Json

    videoId String @db.VarChar(11)
    video   Video  @relation(fields: [videoId], references: [id])

    @@index([createdAt])
    @@index([playlistId])
    @@index([position])
    @@index([updatedAt])
    @@index([videoId])
}

model Setting {
    userId    String   @id @db.VarChar(24)
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    hideShorts Boolean @default(false)
    hideLive   Boolean @default(false)

    @@index([createdAt])
    @@index([updatedAt])
}
